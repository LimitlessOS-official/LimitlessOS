    write_dec_u32(process64_runtime_image_page_count(policy_pid));
    write_string(" offset ");
    write_hex_u32(runtime64_transfer_user_second_page_offset());
    write_string(" note-path-bytes ");
    write_dec_u32(runtime64_transfer_user_second_page_note_path_bytes());
    write_string(" note-bytes ");
    write_dec_u32(runtime64_transfer_user_second_page_note_bytes());
    static const struct scaffold_syscall0_field syscall0_fields_2[] = {
        {" fs-creates ", X64_SYSCALL_FS_CREATE_COUNT, SCAFFOLD_TELEMETRY_DEC},
        {" fs-writes ", X64_SYSCALL_FS_WRITE_COUNT, SCAFFOLD_TELEMETRY_DEC},
        {" fs-reads ", X64_SYSCALL_FS_READ_COUNT, SCAFFOLD_TELEMETRY_DEC},
        {" display-pixels ", X64_SYSCALL_DISPLAY_PIXEL_COUNT, SCAFFOLD_TELEMETRY_DEC},
        {" display-draws ", X64_SYSCALL_DISPLAY_DRAW_COUNT, SCAFFOLD_TELEMETRY_DEC},
        {" display-denials ", X64_SYSCALL_DISPLAY_DENIAL_COUNT, SCAFFOLD_TELEMETRY_DEC},
        {" display-unavailable ", X64_SYSCALL_DISPLAY_UNAVAILABLE_COUNT, SCAFFOLD_TELEMETRY_DEC},
        {" display-token ", X64_SYSCALL_DISPLAY_LAST_TOKEN, SCAFFOLD_TELEMETRY_HEX},
        {" display-available ", X64_SYSCALL_DISPLAY_AVAILABLE, SCAFFOLD_TELEMETRY_DEC},
        {" display-text-writes ", X64_SYSCALL_DISPLAY_TEXT_WRITE_COUNT, SCAFFOLD_TELEMETRY_DEC},
        {" display-text-bytes ", X64_SYSCALL_DISPLAY_TEXT_BYTE_COUNT, SCAFFOLD_TELEMETRY_DEC},
        {" display-clears ", X64_SYSCALL_DISPLAY_CLEAR_COUNT, SCAFFOLD_TELEMETRY_DEC},
        {" display-console-writes ", X64_SYSCALL_DISPLAY_CONSOLE_WRITE_COUNT, SCAFFOLD_TELEMETRY_DEC},
        {" display-console-bytes ", X64_SYSCALL_DISPLAY_CONSOLE_BYTE_COUNT, SCAFFOLD_TELEMETRY_DEC},
        {" display-console-line-clears ", X64_SYSCALL_DISPLAY_CONSOLE_LINE_CLEAR_COUNT, SCAFFOLD_TELEMETRY_DEC},
        {" display-console-wraps ", X64_SYSCALL_DISPLAY_CONSOLE_WRAP_COUNT, SCAFFOLD_TELEMETRY_DEC},
        {" display-console-scrolls ", X64_SYSCALL_DISPLAY_CONSOLE_SCROLL_COUNT, SCAFFOLD_TELEMETRY_DEC}
    };
    write_syscall0_fields(syscall0_fields_2, (u32)(sizeof(syscall0_fields_2) / sizeof(syscall0_fields_2[0])));
