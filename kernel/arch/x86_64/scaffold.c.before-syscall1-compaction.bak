static void __attribute__((noinline)) write_drs_compact_status_fields(
    const char *prefix,
    u64 base_call_id,
    const char *denied_suffix,
    const char *action_suffix)
{
    static const struct scaffold_telemetry_field first_fields[] = {
        {"state ", 0u, SCAFFOLD_TELEMETRY_DEC},
        {"flags ", 1u, SCAFFOLD_TELEMETRY_HEX},
        {"owner ", 2u, SCAFFOLD_TELEMETRY_HEX},
        {"qonly ", 3u, SCAFFOLD_TELEMETRY_DEC},
        {"checksum ", 4u, SCAFFOLD_TELEMETRY_HEX}
    };
    static const struct scaffold_telemetry_field tail_fields[] = {
        {"user-copy ", 7u, SCAFFOLD_TELEMETRY_HEX},
        {"authority ", 8u, SCAFFOLD_TELEMETRY_HEX},
        {"effects ", 9u, SCAFFOLD_TELEMETRY_HEX},
        {"buffer ", 10u, SCAFFOLD_TELEMETRY_DEC},
        {"staged ", 11u, SCAFFOLD_TELEMETRY_DEC},
        {"denials ", 12u, SCAFFOLD_TELEMETRY_DEC},
        {"unavailable ", 13u, SCAFFOLD_TELEMETRY_DEC}
    };
    struct scaffold_telemetry_field transition_fields[2];

    transition_fields[0].suffix = denied_suffix;
    transition_fields[0].selector = 5u;
    transition_fields[0].format = SCAFFOLD_TELEMETRY_DEC;
    transition_fields[1].suffix = action_suffix;
    transition_fields[1].selector = 6u;
    transition_fields[1].format = SCAFFOLD_TELEMETRY_HEX;

    write_syscall0_prefixed_fields(prefix, base_call_id, first_fields, (u32)(sizeof(first_fields) / sizeof(first_fields[0])));
    write_syscall0_prefixed_fields(prefix, base_call_id, transition_fields, 2u);
    write_syscall0_prefixed_fields(prefix, base_call_id, tail_fields, (u32)(sizeof(tail_fields) / sizeof(tail_fields[0])));
}

