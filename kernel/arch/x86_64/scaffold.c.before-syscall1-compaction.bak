static void __attribute__((noinline)) write_drs_load_fields(const char *prefix, u64 call_id)
{
    write_syscall1_dec_u32(" drs-load-state ", call_id, MMIO64_AHCI_DRIVER_READ_STATUS_LOAD_TELEMETRY_STATE);
    write_syscall1_hex_u32(" drs-load-flags ", call_id, MMIO64_AHCI_DRIVER_READ_STATUS_LOAD_TELEMETRY_FLAGS);
    write_syscall1_hex_u32(" drs-load-owner ", call_id, MMIO64_AHCI_DRIVER_READ_STATUS_LOAD_TELEMETRY_OWNER);
    write_syscall1_hex_u32(" drs-load-user-owner ", call_id, MMIO64_AHCI_DRIVER_READ_STATUS_LOAD_TELEMETRY_USER_OWNER);
    write_syscall1_dec_u32(" drs-load-fs-shell-bound ", call_id, MMIO64_AHCI_DRIVER_READ_STATUS_LOAD_TELEMETRY_FS_SHELL_BOUND);
    write_syscall1_dec_u32(" drs-load-binary-read ", call_id, MMIO64_AHCI_DRIVER_READ_STATUS_LOAD_TELEMETRY_BINARY_READ);
    write_syscall1_dec_u32(" drs-load-checksum-verified ", call_id, MMIO64_AHCI_DRIVER_READ_STATUS_LOAD_TELEMETRY_CHECKSUM_VERIFIED);
    write_syscall1_dec_u32(" drs-load-mapped ", call_id, MMIO64_AHCI_DRIVER_READ_STATUS_LOAD_TELEMETRY_MAPPED);
    write_syscall1_dec_u32(" drs-load-launched ", call_id, MMIO64_AHCI_DRIVER_READ_STATUS_LOAD_TELEMETRY_LAUNCHED);
    write_syscall1_dec_u32(" drs-load-ls-completed ", call_id, MMIO64_AHCI_DRIVER_READ_STATUS_LOAD_TELEMETRY_LS_COMPLETED);
    write_string(prefix);
    write_string("source ");
    if ((u32)syscall64_invoke(call_id, MMIO64_AHCI_DRIVER_READ_STATUS_LOAD_TELEMETRY_SOURCE, 0u, 0u) == 1u)
    {
        write_string("disk");
    }
    else
    {
        write_string("unavailable");
    }
    write_syscall1_dec_u32(" drs-load-bytes ", call_id, MMIO64_AHCI_DRIVER_READ_STATUS_LOAD_TELEMETRY_BYTES);
    write_syscall1_hex_u32(" drs-load-checksum ", call_id, MMIO64_AHCI_DRIVER_READ_STATUS_LOAD_TELEMETRY_CHECKSUM);
    write_syscall1_hex_u32(" drs-load-expected-checksum ", call_id, MMIO64_AHCI_DRIVER_READ_STATUS_LOAD_TELEMETRY_EXPECTED_CHECKSUM);
    write_syscall1_dec_u32(" drs-load-mapped-bytes ", call_id, MMIO64_AHCI_DRIVER_READ_STATUS_LOAD_TELEMETRY_MAPPED_BYTES);
    write_syscall1_hex_u32(" drs-load-entry-rip ", call_id, MMIO64_AHCI_DRIVER_READ_STATUS_LOAD_TELEMETRY_ENTRY_RIP);
    write_syscall1_hex_u32(" drs-load-exit-result ", call_id, MMIO64_AHCI_DRIVER_READ_STATUS_LOAD_TELEMETRY_EXIT_RESULT);
    write_syscall1_dec_u32(" drs-load-ls-bytes ", call_id, MMIO64_AHCI_DRIVER_READ_STATUS_LOAD_TELEMETRY_LS_BYTES);
    write_syscall1_dec_u32(" drs-load-write ", call_id, MMIO64_AHCI_DRIVER_READ_STATUS_LOAD_TELEMETRY_WRITE_AUTHORITY);
    write_syscall1_dec_u32(" drs-load-commit ", call_id, MMIO64_AHCI_DRIVER_READ_STATUS_LOAD_TELEMETRY_COMMIT_AUTHORITY);
    write_syscall1_dec_u32(" drs-load-additional-fs-caps ", call_id, MMIO64_AHCI_DRIVER_READ_STATUS_LOAD_TELEMETRY_ADDITIONAL_FS_CAPS);
    write_syscall1_dec_u32(" drs-load-staged ", call_id, MMIO64_AHCI_DRIVER_READ_STATUS_LOAD_TELEMETRY_STAGE_COUNT);
    write_syscall1_dec_u32(" drs-load-denials ", call_id, MMIO64_AHCI_DRIVER_READ_STATUS_LOAD_TELEMETRY_DENIAL_COUNT);
    write_syscall1_dec_u32(" drs-load-unavailable ", call_id, MMIO64_AHCI_DRIVER_READ_STATUS_LOAD_TELEMETRY_UNAVAILABLE_COUNT);
    (void)prefix;
}

